  <!-- ==================== SECTION: VIP CONSULTATION FORM ==================== -->
  <section id="sec-inquiry" class="content-section py-14 sm:py-20 bg-sigan-green text-white relative">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-xl mx-auto mb-8 sm:mb-14">
        <span class="text-xs sm:text-sm font-bold text-sigan-gold uppercase tracking-widest" data-editable>VIP RESERVATION</span>
        <h2 class="text-xl sm:text-3xl lg:text-4xl font-black mt-1 tracking-tight" data-editable>VIP 관심고객 등록 및 모델하우스 방문예약</h2>
        <div class="w-12 h-1 bg-sigan-gold mx-auto mt-2.5"></div>
        <p class="text-slate-200 text-xs sm:text-sm mt-2.5 break-keep" data-editable>
          등록 즉시 전문 상담원이 배정되어 상가 배치도, MD 구성표, 호실별 분양가 자료를 우선 발송해 드립니다.
        </p>
      </div>

      <!-- 구글 시트 실시간 자동 전송 폼 -->
      <div class="bg-white rounded-2xl sm:rounded-3xl p-5 sm:p-9 text-slate-900 shadow-2xl border border-sigan-gold/40">
        <form onsubmit="handleMainSubmit(event)" class="space-y-3.5 sm:space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
            <div>
              <label class="block text-xs sm:text-sm font-bold text-slate-700 mb-1">고객 성함 <span class="text-sigan-accentRed">*</span></label>
              <input type="text" id="mainName" required placeholder="성함을 입력하세요 (예: 홍길동)" class="w-full bg-slate-50 border border-slate-300 focus:border-sigan-green focus:bg-white text-slate-900 text-xs sm:text-sm rounded-xl px-3.5 py-2.5 sm:px-4 sm:py-3 outline-none transition" />
            </div>
            <div>
              <label class="block text-xs sm:text-sm font-bold text-slate-700 mb-1">휴대폰 번호 <span class="text-sigan-accentRed">*</span></label>
              <input type="tel" id="mainPhone" required placeholder="010-1234-5678" class="w-full bg-slate-50 border border-slate-300 focus:border-sigan-green focus:bg-white text-slate-900 text-xs sm:text-sm rounded-xl px-3.5 py-2.5 sm:px-4 sm:py-3 outline-none transition" />
            </div>
          </div>

          <!-- 관심 구분 (선택사항) -->
          <div>
            <label class="block text-xs sm:text-sm font-bold text-slate-700 mb-1">
              관심 구분 <span class="text-slate-400 font-normal">(선택사항 - 미선택 시 종합상담)</span>
            </label>
            <select id="mainBlock" class="w-full bg-slate-50 border border-slate-300 focus:border-sigan-green text-slate-800 text-xs sm:text-sm rounded-xl px-3.5 py-2.5 sm:px-4 sm:py-3 outline-none transition">
              <option value="전체상담">선택안함 (전체 호실 및 분양가 상담)</option>
              <option value="마스터리스">마스터리스 (5년 6% 확정수익 보장 호실)</option>
              <option value="3블록(에듀특화)">AC3블록 (학원·에듀·식음 특화존)</option>
              <option value="4블록(메디컬특화)">AC4블록 (병원·약국·클리닉 특화존)</option>
            </select>
          </div>

          <div>
            <label class="block text-xs sm:text-sm font-bold text-slate-700 mb-1">
              추가 문의사항 <span class="text-slate-400 font-normal">(선택)</span>
            </label>
            <textarea id="mainMemo" rows="3" placeholder="궁금하신 내용이나 희망 상담시간대를 자유롭게 남겨주세요." class="w-full bg-slate-50 border border-slate-300 focus:border-sigan-green focus:bg-white text-slate-900 text-xs sm:text-sm rounded-xl px-3.5 py-2.5 sm:px-4 sm:py-3 outline-none resize-none transition"></textarea>
          </div>

          <button type="submit" class="w-full py-3.5 sm:py-4 rounded-xl bg-sigan-green text-white font-bold text-sm sm:text-base hover:bg-sigan-greenLight active:scale-[0.99] transition shadow-xl flex items-center justify-center">
            <i data-lucide="check-circle" class="w-4 h-4 mr-1.5 text-sigan-gold"></i>
            <span data-editable>VIP 관심고객 등록 & 상담신청 완료하기</span>
          </button>

          <p class="text-center text-[11px] sm:text-xs text-slate-400 break-keep" data-editable>
            입력하신 개인정보는 암호화되어 안전하게 관리되며, 상가 분양 안내 목적 외에는 사용되지 않습니다.
          </p>
        </form>
      </div>

    </div>
  </section>


