    <div class="bg-white rounded-3xl max-w-sm w-full p-6 text-center space-y-4 shadow-2xl animate-[fadeIn_0.2s_ease-out]">
      <div class="w-14 h-14 bg-emerald-100 rounded-full flex items-center justify-center mx-auto text-sigan-green">
        <i data-lucide="check" class="w-8 h-8"></i>
      </div>
      <div>
        <h3 class="text-lg font-black text-slate-900">상담 신청 접수 완료</h3>
        <p id="successMessage" class="text-xs text-slate-600 mt-2 leading-relaxed">
          고객님의 상담 접수가 정상적으로 완료되었습니다.<br>
          전문 상담사가 빠른 시간 내에 연락드립니다.
        </p>
      </div>
      <button onclick="closeSuccessModal()" class="w-full py-3 rounded-xl bg-sigan-green text-white font-bold text-xs hover:bg-sigan-greenLight transition">
        확인
      </button>
    </div>
  </div>


  <!-- ==================== PRIVACY MODAL ==================== -->
  <div id="privacyModal" class="fixed inset-0 z-50 hidden bg-black/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 text-slate-900 space-y-4 shadow-2xl max-h-[80vh] overflow-y-auto">
      <div class="flex justify-between items-center pb-3 border-b border-slate-200">
        <h3 class="font-bold text-base">개인정보 처리방침 안내</h3>
        <button onclick="closePrivacyModal()" class="text-slate-400 hover:text-slate-600">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
      <div class="text-xs text-slate-600 space-y-2 leading-relaxed">
        <p><strong>1. 수집하는 개인정보 항목:</strong> 성명, 연락처(휴대폰 번호), 관심구분, 문의내용</p>
        <p><strong>2. 수집 및 이용 목적:</strong> 인천계양 상업시설 「시간」 분양 상담, 호실 배치도 및 분양가 자료 제공, 견본주택 방문예약 확인</p>
        <p><strong>3. 보유 및 이용 기간:</strong> 분양 완료 시 또는 고객의 개인정보 삭제 요청 시까지 지체 없이 파기합니다.</p>
        <p><strong>4. 동의 거부 권리:</strong> 개인정보 수집에 동의를 거부할 권리가 있으며, 동의 거부 시 분양 상담 및 예약 서비스 제공이 제한될 수 있습니다.</p>
      </div>
      <button onclick="closePrivacyModal()" class="w-full py-3 rounded-xl bg-slate-100 text-slate-800 font-bold text-xs hover:bg-slate-200 transition">
        닫기
      </button>
    </div>
  </div>


  <!-- ==================== JAVASCRIPT ==================== -->
  <script>
    lucide.createIcons();

    // Section Switching (SPA Tab Navigation)
    const sectionIds = ['overview', 'premium', 'rarity', 'blocks', 'location', 'inquiry'];
    const sectionNames = {
      'all': '전체 한눈에 보기',
      'overview': '1. 사업개요 (규모 및 면적표)',
      'premium': '2. 공식 8대 프리미엄 (PREMIUM 8)',
      'rarity': '3. 상업용지 0.91% 희소가치 비교',
      'blocks': '4. 3블록·4블록 층별 MD 구성',
      'location': '5. 입지환경 및 오시는 길',
      'inquiry': '6. VIP 방문예약 및 상담신청'
    };

    function showSection(target) {
      document.querySelectorAll('.nav-tab-btn').forEach(btn => btn.classList.remove('is-active'));
      const activeBtn = document.getElementById(`navBtn-${target}`);
      if (activeBtn) activeBtn.classList.add('is-active');

      const indicator = document.getElementById('sectionIndicatorBar');
      const indicatorText = document.getElementById('currentSectionName');
      const hero = document.getElementById('sec-hero');

      if (target === 'all') {
        if (hero) hero.classList.remove('hidden');
        sectionIds.forEach(id => {
          const el = document.getElementById(`sec-${id}`);
          if (el) el.classList.remove('hidden');
        });
        indicator.classList.add('hidden');
        window.scrollTo({ top: 0, behavior: 'smooth' });
      } else {
        if (hero) hero.classList.add('hidden');
        sectionIds.forEach(id => {
          const el = document.getElementById(`sec-${id}`);
          if (!el) return;
          if (id === target) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
        indicator.classList.remove('hidden');
        indicatorText.innerText = sectionNames[target] || target;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function openMobilePreviewModal() {
      const modal = document.getElementById('mobilePreviewModal');
      const iframe = document.getElementById('mobilePreviewFrame');
      iframe.src = window.location.href;
      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeMobilePreviewModal() {
      document.getElementById('mobilePreviewModal').classList.add('hidden');
      document.body.style.overflow = '';
    }

    function toggleMobileMenu() {
      document.getElementById('mobileMenu').classList.toggle('hidden');
    }
    document.getElementById('mobileMenuBtn').addEventListener('click', toggleMobileMenu);

    function switchBlock(blockId) {
      document.querySelectorAll('.block-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('bg-sigan-green', 'text-white', 'shadow-sm');
        btn.classList.add('text-slate-600');
      });

      const targetContent = document.getElementById(`content-${blockId}`);
      const targetBtn = document.getElementById(`tabBtn-${blockId}`);
      if (targetContent) targetContent.classList.remove('hidden');
      if (targetBtn) {
        targetBtn.classList.add('bg-sigan-green', 'text-white', 'shadow-sm');
        targetBtn.classList.remove('text-slate-600');
      }
    }

    function openPrivacyModal() { document.getElementById('privacyModal').classList.remove('hidden'); }
    function closePrivacyModal() { document.getElementById('privacyModal').classList.add('hidden'); }
    function openSuccessModal(name, phone) {
      document.getElementById('successMessage').innerHTML = `<strong class="text-sigan-green">${name}</strong> 고객님, 상담 접수가 완료되었습니다.<br>입력하신 연락처(${phone})로 담당자가 상가 배치도 및 분양가 안내자료를 전송해 드립니다.`;
      document.getElementById('successModal').classList.remove('hidden');
    }
    function closeSuccessModal() { document.getElementById('successModal').classList.add('hidden'); }

    function copyAddress(address) {
      navigator.clipboard.writeText(address).then(() => {
        alert('주소가 복사되었습니다: ' + address);
      }).catch(() => {
        prompt('아래 주소를 복사하세요:', address);
      });
    }

    // Map Zoom Modal Controls
    function openMapZoomModal(imgSrc) {
      document.getElementById('zoomModalImg').src = imgSrc;
      document.getElementById('mapZoomModal').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      lucide.createIcons();
    }
    function closeMapZoomModal() {
      document.getElementById('mapZoomModal').classList.add('hidden');
      document.body.style.overflow = '';
    }

    // Forms - Google Sheet Live Integration
    const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbx9uxIMwjCLJk_JwQ9fnHKLL_WEd4xImMnF0uWwmHAgcVtkot7qZOyLWBo3J-4H6jjZ/exec';

    async function sendToGoogleSheet(payload, submitBtn, originalBtnHtml) {
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
        submitBtn.innerHTML = '<span class="inline-block animate-spin mr-2">⏳</span><span>신청서 전송 중...</span>';
      }

      try {
        await fetch(GOOGLE_SCRIPT_URL, {
          method: 'POST',
          mode: 'no-cors',
          headers: {
            'Content-Type': 'text/plain;charset=utf-8'
          },
          body: JSON.stringify(payload)
        });
        return true;
      } catch (err) {
        console.error('구글 시트 전송 오류:', err);
        return false;
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.classList.remove('opacity-75', 'cursor-not-allowed');
          submitBtn.innerHTML = originalBtnHtml;
        }
      }
    }

    async function handleQuickSubmit(e) {
      e.preventDefault();
      if (isEditing) return;
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalHtml = submitBtn ? submitBtn.innerHTML : '';

      const name = form.userName.value.trim();
      const phone = form.userPhone.value.trim();

      const payload = {
        name: name,
        phone: phone,
        block: '상단 빠른신청 (종합상담)',
        memo: '메인 상단 간편조회 폼 접수',
        formType: '상단 퀵 폼'
      };

      await sendToGoogleSheet(payload, submitBtn, originalHtml);
      openSuccessModal(name, phone);
      form.reset();
    }

    async function handleMainSubmit(e) {
      e.preventDefault();
      if (isEditing) return;
      const form = e.target;
      const submitBtn = form.querySelector('button[type="submit"]');
      const originalHtml = submitBtn ? submitBtn.innerHTML : '';

      const name = document.getElementById('mainName').value.trim();
      const phone = document.getElementById('mainPhone').value.trim();
      const block = document.getElementById('mainBlock').value;
      const memo = document.getElementById('mainMemo').value.trim();

      const payload = {
        name: name,
        phone: phone,
        block: block,
        memo: memo,
        formType: '하단 VIP 상담 폼'
      };

      await sendToGoogleSheet(payload, submitBtn, originalHtml);
      openSuccessModal(name, phone);
      form.reset();
    }


    /* =========================================================
       WIX-STYLE LIVE VISUAL EDITOR & UNIVERSAL IMAGE STUDIO
       ========================================================= */
    let isEditing = false;
    let activeImage = null;
    let newImageBase64 = null;

    function toggleWixEditMode() {
      isEditing = !isEditing;
      const body = document.body;
      const dot = document.getElementById('editStatusDot');
      const statusText = document.getElementById('editStatusText');
      const toggleBtnText = document.getElementById('toggleBtnText');
      const actionBtns = document.getElementById('editorActionBtns');

      if (isEditing) {
        body.classList.add('is-editing');
        dot.classList.remove('bg-slate-500');
        dot.classList.add('bg-emerald-400', 'animate-pulse');
        statusText.innerText = 'Wix 편집 중';
        statusText.classList.add('text-emerald-400');
        toggleBtnText.innerText = '편집 완료';
        actionBtns.classList.remove('hidden');

        document.querySelectorAll('[data-editable]').forEach(el => {
          el.contentEditable = 'true';
          el.spellcheck = false;
        });

        attachUniversalImageListeners();
        alert('Wix 편집 모드가 켜졌습니다!\n\n1. 텍스트를 클릭하면 즉시 타이핑하여 수정할 수 있습니다.\n2. 사진을 클릭하면 크기, 비율, 모양을 조절하는 [Image Studio]가 열립니다.\n3. 상단 [➕ 새 이미지 추가] 버튼으로 원하는 섹션에 사진을 넣을 수 있습니다.');
      } else {
        body.classList.remove('is-editing');
        dot.classList.remove('bg-emerald-400', 'animate-pulse');
        dot.classList.add('bg-slate-500');
        statusText.innerText = '보기 모드';
        statusText.classList.remove('text-emerald-400');
        toggleBtnText.innerText = 'Wix 편집 켜기';
        actionBtns.classList.add('hidden');
        closeImageStudio();

        document.querySelectorAll('[data-editable]').forEach(el => {
          el.contentEditable = 'false';
        });

        if (activeImage) {
          activeImage.classList.remove('is-active-img');
          activeImage = null;
        }
      }
    }

    function attachUniversalImageListeners() {
      document.querySelectorAll('img').forEach(img => {
        img.onclick = (e) => {
          if (!isEditing) return;
          e.preventDefault();
          e.stopPropagation();
          selectImageForEditing(img);
        };
      });
    }

    function selectImageForEditing(img) {
      if (activeImage) {
        activeImage.classList.remove('is-active-img');
      }
      activeImage = img;
      activeImage.classList.add('is-active-img');

      const panel = document.getElementById('imageStudioPanel');
      panel.classList.remove('hidden');

      const currentWidth = img.style.width || '100%';
      let widthNum = 100;
      if (currentWidth.includes('%')) {
        widthNum = parseInt(currentWidth);
      }
      document.getElementById('sliderWidth').value = widthNum;
      document.getElementById('labelWidthVal').innerText = currentWidth;
      
      lucide.createIcons();
    }

    function closeImageStudio() {
      const panel = document.getElementById('imageStudioPanel');
      panel.classList.add('hidden');
      if (activeImage) {
        activeImage.classList.remove('is-active-img');
        activeImage = null;
      }
    }

    function triggerReplaceImage() {
      if (!activeImage) return;
      document.getElementById('imageReplaceUploader').click();
    }

    function handleReplaceImageSelected(e) {
      const file = e.target.files[0];
      if (!file || !activeImage) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        activeImage.src = evt.target.result;
        alert('사진이 성공적으로 교체되었습니다! [수정본 파일 저장]을 누르면 반영됩니다.');
      };
      reader.readAsDataURL(file);
      e.target.value = '';
    }

    function deleteActiveImage() {
      if (!activeImage) return;
      if (activeImage.id === 'mapImage' || activeImage.src.includes('logo.png')) {
        if (!confirm('이 이미지는 필수 구성 이미지입니다. 정말 삭제하시겠습니까?')) return;
      } else {
        if (!confirm('선택하신 이미지를 삭제하시겠습니까?')) return;
      }
      
      const parentCard = activeImage.closest('.user-image-card') || activeImage.parentElement;
      if (parentCard && parentCard.classList.contains('user-image-card')) {
        parentCard.remove();
      } else {
        activeImage.remove();
      }
      closeImageStudio();
    }

    function applyImageWidth(val) {
      if (!activeImage) return;
      activeImage.style.width = val + '%';
      document.getElementById('labelWidthVal').innerText = val + '%';
    }

    function applyImageWidthPreset(preset) {
      if (!activeImage) return;
      if (preset === 'auto') {
        activeImage.style.width = 'auto';
        document.getElementById('labelWidthVal').innerText = '원본';
      } else {
        activeImage.style.width = preset;
        document.getElementById('sliderWidth').value = parseInt(preset);
        document.getElementById('labelWidthVal').innerText = preset;
      }
    }

    function applyImageRatio(ratio) {
      if (!activeImage) return;
      if (ratio === 'auto') {
        activeImage.style.aspectRatio = 'auto';
        activeImage.style.height = 'auto';
        activeImage.style.objectFit = 'contain';
        document.getElementById('labelHeightVal').innerText = '원본 비율';
      } else {
        activeImage.style.aspectRatio = ratio;
        activeImage.style.height = 'auto';
        activeImage.style.objectFit = 'cover';
        document.getElementById('labelHeightVal').innerText = ratio;
      }
    }

    function applyImageHeight(val) {
      if (!activeImage) return;
      activeImage.style.aspectRatio = 'auto';
      activeImage.style.height = val + 'px';
      activeImage.style.objectFit = 'cover';
      document.getElementById('labelHeightVal').innerText = val + 'px';
    }

    function applyImageShape(shape) {
      if (!activeImage) return;
      activeImage.classList.remove('rounded-none', 'rounded-xl', 'rounded-2xl', 'rounded-3xl', 'rounded-full');
      if (shape === 'none') {
        activeImage.style.borderRadius = '0px';
      } else if (shape === 'rounded-xl') {
        activeImage.style.borderRadius = '12px';
      } else if (shape === 'rounded-3xl') {
        activeImage.style.borderRadius = '24px';
      } else if (shape === 'rounded-full') {
        activeImage.style.borderRadius = '9999px';
      }
    }

    function applyImageBorder(type) {
      if (!activeImage) return;
      if (type === 'none') {
        activeImage.style.border = 'none';
      } else if (type === 'slate') {
        activeImage.style.border = '2px solid #cbd5e1';
      } else if (type === 'gold') {
        activeImage.style.border = '3px solid #c59b6d';
      } else if (type === 'green') {
        activeImage.style.border = '3px solid #0c2f24';
      }
    }

    function applyImageAlign(align) {
      if (!activeImage) return;
      activeImage.style.display = 'block';
      if (align === 'center') {
        activeImage.style.marginLeft = 'auto';
        activeImage.style.marginRight = 'auto';
      } else if (align === 'left') {
        activeImage.style.marginLeft = '0';
        activeImage.style.marginRight = 'auto';
      } else if (align === 'right') {
        activeImage.style.marginLeft = 'auto';
        activeImage.style.marginRight = '0';
      }
    }

    // ================= ADD NEW IMAGE TOOL ================= //
    function openAddImageModal(targetSection) {
      if (!isEditing) {
        toggleWixEditMode();
      }
      if (targetSection) {
        const select = document.getElementById('newImageTargetSection');
        if (select) select.value = targetSection;
      }
      newImageBase64 = null;
      document.getElementById('newImageFileName').innerText = '';
      document.getElementById('newImageCaption').value = '';
      document.getElementById('addImageModal').classList.remove('hidden');
      lucide.createIcons();
    }

    function closeAddImageModal() {
      document.getElementById('addImageModal').classList.add('hidden');
    }

    function handleAddImageFileSelected(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(evt) {
        newImageBase64 = evt.target.result;
        document.getElementById('newImageFileName').innerText = '✓ 파일 준비됨: ' + file.name;
      };
      reader.readAsDataURL(file);
      e.target.value = '';
    }

    function promptForImageUrl() {
      const url = prompt('추가하실 이미지의 인터넷 주소(URL)를 입력하세요:', 'https://images.unsplash.com/photo-1541888946425-d0fbb18615f3?auto=format&fit=crop&w=1200&q=80');
      if (url && url.trim()) {
        newImageBase64 = url.trim();
        document.getElementById('newImageFileName').innerText = '✓ URL 연결됨: ' + url.substring(0, 35) + '...';
      }
    }

    function confirmAddNewImage() {
      if (!newImageBase64) {
        alert('먼저 내 PC에서 사진을 선택하거나 이미지 URL을 입력해 주세요.');
        return;
      }

      const sectionId = document.getElementById('newImageTargetSection').value;
      const container = document.getElementById(sectionId);
      if (!container) {
        alert('선택하신 섹션 컨테이너를 찾을 수 없습니다.');
        return;
      }

      const caption = document.getElementById('newImageCaption').value.trim() || '사진 설명 입력';
      const sizeRadio = document.querySelector('input[name="initSize"]:checked');
      const initSize = sizeRadio ? sizeRadio.value : '100%';

      const card = document.createElement('div');
      card.className = 'user-image-card relative rounded-3xl overflow-hidden border border-slate-200 shadow-sm bg-slate-100 group transition hover:shadow-md';
      card.innerHTML = `
        <img 
          src="${newImageBase64}" 
          alt="${caption}" 
          style="width: ${initSize}; margin: 0 auto; display: block; border-radius: 16px; object-fit: cover;" 
          class="h-64 sm:h-80" 
        />
        <div class="p-4 bg-white flex justify-between items-center border-t border-slate-100">
          <span class="text-xs sm:text-sm font-bold text-slate-800" data-editable>${caption}</span>
          <button onclick="this.closest('.user-image-card').remove()" class="text-xs bg-rose-50 text-rose-600 px-2.5 py-1 rounded-lg font-semibold hover:bg-rose-100">
            삭제
          </button>
        </div>
      `;

      container.appendChild(card);
      closeAddImageModal();

      card.querySelectorAll('[data-editable]').forEach(el => {
        el.contentEditable = 'true';
        el.spellcheck = false;
      });
      const newImg = card.querySelector('img');
      newImg.onclick = (e) => {
        if (!isEditing) return;
        e.preventDefault();
        e.stopPropagation();
        selectImageForEditing(newImg);
      };

      selectImageForEditing(newImg);
      alert('새 이미지가 성공적으로 추가되었습니다!\n\n하단의 [Image Studio]에서 원하는 크기와 모양으로 바로 조절하실 수 있습니다.');
    }

    function downloadEditedHtml() {
      const wasEditing = isEditing;
      if (wasEditing) toggleWixEditMode();

      showSection('all');

      const htmlContent = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
      const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = 'index.html';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(link.href);

      alert('수정하신 최종 index.html 파일이 다운로드 폴더에 안전하게 저장되었습니다!');
      if (wasEditing) toggleWixEditMode();
    }

    function resetToOriginal() {
      if (confirm('모든 수정을 취소하고 원래대로 새로고침하시겠습니까?')) {
        location.reload();
      }
    }
  </script>

</body>
</html>