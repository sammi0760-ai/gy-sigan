        [전체 한눈에 보기로 복귀]
      </button>
    </div>
  </div>


  <!-- ==================== HERO SECTION ==================== -->
  <section id="sec-hero" class="relative bg-sigan-greenDeep text-white overflow-hidden pt-12 pb-16 sm:py-24">
    <!-- Clean Luxury Background Decor (은은한 골드 & 딥그린 블러 그라데이션) -->
    <div class="absolute inset-0 pointer-events-none select-none z-0">
      <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-sigan-gold/15 blur-3xl"></div>
      <div class="absolute bottom-0 -left-40 w-96 h-96 rounded-full bg-sigan-greenSoft/25 blur-3xl"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[#08281d] via-[#0c2f24] to-[#08281d]/95"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- ==================== 공식 특별 분양 혜택 바 ==================== -->
      <!-- Desktop Version (hidden sm:flex) -->
      <div class="hidden sm:flex mb-8 p-4 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 items-center justify-between gap-4 text-xs sm:text-sm shadow-md">
        <div class="flex items-center space-x-2.5">
          <span class="px-2.5 py-1 rounded-md bg-sigan-coral text-white font-extrabold text-xs uppercase tracking-wider">OFFICIAL SPECIAL</span>
          <span class="font-bold text-sigan-gold" data-editable>선착순 공식 특별 분양 혜택 안내</span>
        </div>
        <div class="flex items-center space-x-4 text-slate-200 text-xs sm:text-sm font-medium">
          <span class="flex items-center"><i data-lucide="check" class="w-3.5 h-3.5 mr-1 text-sigan-gold"></i>5년 6% 확정수익</span>
          <span class="flex items-center"><i data-lucide="check" class="w-3.5 h-3.5 mr-1 text-sigan-gold"></i>계약금 연 5% 이자지원</span>
          <span class="flex items-center"><i data-lucide="check" class="w-3.5 h-3.5 mr-1 text-sigan-gold"></i>중도금 무이자</span>
        </div>
      </div>

      <!-- Mobile Dedicated Version (block sm:hidden - 모바일 최적화 정렬 디자인) -->
      <div class="block sm:hidden mb-6 p-3.5 rounded-2xl bg-white/[0.08] backdrop-blur-md border border-white/15 shadow-md">
        <div class="flex items-center justify-between pb-2.5 border-b border-white/10">
          <div class="flex items-center space-x-2">
            <span class="px-2 py-0.5 rounded-md bg-sigan-coral text-white font-black text-[10px] tracking-wider uppercase">SPECIAL</span>
            <span class="font-bold text-sigan-gold text-xs tracking-tight" data-editable>공식 특별 분양 혜택 안내</span>
          </div>
          <span class="text-[10px] text-emerald-300 font-bold bg-emerald-950/60 px-1.5 py-0.5 rounded border border-emerald-500/30">선착순</span>
        </div>
        <div class="grid grid-cols-3 gap-1.5 pt-2 text-center">
          <div class="bg-black/30 rounded-xl py-2 px-1 border border-white/5">
            <span class="text-[10px] text-slate-300 block font-medium">확정수익</span>
            <strong class="text-xs font-black text-sigan-gold block mt-0.5">5년 6%</strong>
          </div>
          <div class="bg-black/30 rounded-xl py-2 px-1 border border-white/5">
            <span class="text-[10px] text-slate-300 block font-medium">이자지원</span>
            <strong class="text-xs font-black text-sigan-gold block mt-0.5">연 5%</strong>
          </div>
          <div class="bg-black/30 rounded-xl py-2 px-1 border border-white/5">
            <span class="text-[10px] text-slate-300 block font-medium">중도금</span>
            <strong class="text-xs font-black text-emerald-400 block mt-0.5">무이자</strong>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Hero Text -->
        <div class="lg:col-span-7 space-y-4 sm:space-y-6 text-left">
          <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs text-sigan-gold font-bold">
            <span class="w-2 h-2 rounded-full bg-sigan-gold animate-pulse"></span>
            <span data-editable>계양신도시 첫 라이프 스테이 몰</span>
          </div>

          <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-snug sm:leading-tight">
            <span class="block text-slate-200 text-base sm:text-2xl font-light mb-1" data-editable>머무름이 곧 가치가 되는 곳</span>
            <span class="text-white" data-editable>인천계양 상업시설</span>
            <span class="text-sigan-gold block mt-0.5" data-editable>「시간(時間)」</span>
          </h1>

          <p class="text-slate-300 text-xs sm:text-base lg:text-lg leading-relaxed font-light break-keep" data-editable>
            첨단산업단지 <strong class="text-white font-bold">계양AX파크</strong>의 풍부한 배후수요와 투자가치!<br class="hidden sm:block">
            택지 내 상업시설용지 단 <strong class="text-sigan-gold font-bold">0.91%</strong>의 독점적 프리미엄을 선점하십시오.
          </p>

          <!-- 3대 핵심 혜택 -->
          <div class="grid grid-cols-3 gap-1.5 sm:gap-3 pt-1 sm:pt-2">
            <div class="bg-white/10 backdrop-blur-md rounded-xl p-2.5 sm:p-3 border border-white/15 text-center sm:text-left">
              <span class="text-[10px] sm:text-[11px] text-slate-300 block truncate">마스터리스</span>
              <p class="text-xs sm:text-sm font-extrabold text-sigan-gold mt-0.5" data-editable>연 6% (5년)</p>
            </div>
            <div class="bg-white/10 backdrop-blur-md rounded-xl p-2.5 sm:p-3 border border-white/15 text-center sm:text-left">
              <span class="text-[10px] sm:text-[11px] text-slate-300 block truncate">계약금 혜택</span>
              <p class="text-xs sm:text-sm font-extrabold text-sigan-gold mt-0.5" data-editable>연 5% 지원</p>
            </div>
            <div class="bg-white/10 backdrop-blur-md rounded-xl p-2.5 sm:p-3 border border-white/15 text-center sm:text-left">
              <span class="text-[10px] sm:text-[11px] text-slate-300 block truncate">중도금 안심</span>
              <p class="text-xs sm:text-sm font-extrabold text-sigan-gold mt-0.5" data-editable>40% 무이자</p>
            </div>
          </div>

          <div class="pt-2 grid grid-cols-1 sm:flex gap-2.5 sm:gap-3">
            <a href="#sec-inquiry" class="w-full sm:w-auto justify-center px-6 py-3.5 rounded-xl bg-sigan-gold text-slate-950 font-black text-sm sm:text-base hover:bg-amber-300 transition shadow-xl flex items-center">
              <i data-lucide="file-text" class="w-4 h-4 mr-2"></i>
              VIP 잔여호실 및 분양가 조회
            </a>
            <a href="tel:1800-0320" class="w-full sm:w-auto justify-center px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-sm sm:text-base border border-white/30 transition flex items-center">
              <i data-lucide="phone" class="w-4 h-4 mr-2 text-sigan-gold"></i>
              대표문의 1800-0320
            </a>
          </div>
        </div>

        <!-- Hero Quick Form (성함과 연락처 2개만 바로 입력하여 1초 구글시트 접수) -->
        <div class="lg:col-span-5">
          <div class="bg-white text-slate-900 rounded-2xl sm:rounded-3xl p-5 sm:p-8 shadow-2xl border border-slate-200">
            <div class="flex items-center justify-between pb-3.5 border-b border-slate-200">
              <div>
                <span class="text-[10px] sm:text-[11px] font-bold text-sigan-green uppercase tracking-wider" data-editable>FAST INQUIRY</span>
                <h3 class="text-base sm:text-xl font-black text-slate-900" data-editable>분양가 및 잔여호실 간편 조회</h3>
              </div>
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500 animate-ping"></span>
            </div>

            <p class="text-xs text-slate-500 mt-2.5 break-keep" data-editable>
              성함과 연락처를 남겨주시면 담당자가 호실 배치도와 층별 분양가를 1:1로 발송해 드립니다.
            </p>

            <form onsubmit="handleQuickSubmit(event)" class="mt-4 space-y-3 sm:space-y-3.5">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">고객 성함</label>
                <input 
                  type="text" 
                  name="userName" 
                  required 
                  placeholder="예: 홍길동" 
                  class="w-full bg-slate-50 border border-slate-300 focus:border-sigan-green focus:bg-white text-slate-900 text-sm rounded-xl px-3.5 py-2.5 sm:py-3 outline-none transition"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">휴대폰 번호</label>
                <input 
                  type="tel" 
                  name="userPhone" 
                  required 
                  placeholder="010-0000-0000" 
                  class="w-full bg-slate-50 border border-slate-300 focus:border-sigan-green focus:bg-white text-slate-900 text-sm rounded-xl px-3.5 py-2.5 sm:py-3 outline-none transition"
                />
              </div>

              <div class="pt-1">
                <button 
                  type="submit" 
                  class="w-full py-3.5 sm:py-4 rounded-xl bg-sigan-green text-white font-extrabold text-sm sm:text-base hover:bg-sigan-greenLight active:scale-[0.99] transition shadow-lg flex items-center justify-center">
                  <i data-lucide="send" class="w-4 h-4 mr-1.5 text-sigan-gold"></i>
                  <span data-editable>호실별 분양가 자료 즉시 요청하기</span>
                </button>
              </div>

              <div class="text-[10px] sm:text-[11px] text-slate-500 flex items-center justify-center space-x-1">
                <i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-600"></i>
                <span data-editable>개인정보는 분양안내 상담 목적 외 일체 사용되지 않습니다.</span>
              </div>
            </form>
          </div>
        </div>

      </div>

      <!-- Hero Bottom Stats Bar (수치 정확 표기) -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-2 sm:gap-4 mt-8 sm:mt-10 pt-6 sm:pt-8 border-t border-white/10 text-center">
        <div class="bg-white/5 rounded-xl sm:rounded-2xl p-3 sm:p-4 border border-white/10">
          <span class="text-[11px] sm:text-sm text-slate-300 block font-semibold" data-editable>총 상가 규모</span>
          <p class="text-xl sm:text-4xl font-black text-sigan-gold mt-1" data-editable>총 203실</p>
          <span class="text-[10px] sm:text-xs text-slate-400 mt-0.5 block truncate" data-editable>AC3BL 112실 / AC4BL 91실</span>
        </div>
        <div class="bg-white/5 rounded-xl sm:rounded-2xl p-3 sm:p-4 border border-white/10">
          <span class="text-[11px] sm:text-sm text-slate-300 block font-semibold" data-editable>상업용지비율</span>
          <p class="text-xl sm:text-4xl font-black text-white mt-1" data-editable>0.91%</p>
          <span class="text-[10px] sm:text-xs text-slate-400 mt-0.5 block truncate" data-editable>수도권 신도시 최저 수준 희소성</span>
        </div>
        <div class="bg-white/5 rounded-xl sm:rounded-2xl p-3 sm:p-4 border border-white/10">
          <span class="text-[11px] sm:text-sm text-slate-300 block font-semibold" data-editable>마스터리스 호실</span>
          <p class="text-xl sm:text-4xl font-black text-sigan-gold mt-1" data-editable>5년 6%</p>
          <span class="text-[10px] sm:text-xs text-slate-400 mt-0.5 block truncate" data-editable>반도건설 직접 통임차 확정수익</span>
        </div>
        <div class="bg-white/5 rounded-xl sm:rounded-2xl p-3 sm:p-4 border border-white/10">
