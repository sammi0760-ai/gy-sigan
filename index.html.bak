<!DOCTYPE html>
<html lang="ko" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>인천계양 상업시설 「시간 (時間)」 | 공식 브랜드 사이트</title>
  <meta name="description" content="계양신도시 첫 라이프 스테이 몰 「시간(時間)」 반도건설 시공. 상업용지비율 0.91% 압도적 희소가치, 마스터리스 5년간 6% 수익보장, 계약금 연 5% 이자지원, 중도금 무이자">
  
  <!-- Pretendard Web Font -->
  <link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css" />
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            sigan: {
              greenDeep: '#08281d',
              green: '#0c2f24',
              greenLight: '#18533f',
              greenSoft: '#226951',
              gold: '#c59b6d',
              goldLight: '#ecd9bc',
              coral: '#d97a52',
              cream: '#f8f6f0',
              beige: '#eae4d8',
              slateCard: '#f3f4f6',
              textMain: '#111111',
              textSub: '#4e5968',
              accentRed: '#e11d48'
            }
          },
          fontFamily: {
            sans: ['Pretendard', '-apple-system', 'BlinkMacSystemFont', 'system-ui', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <style>
    /* 전체 폰트 Pretendard 완벽 통일 & 한글 단어 끊김 방지 & 모바일 가독성 최적화 */
    html {
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
    }
    *, html, body, table, th, td, span, p, h1, h2, h3, h4, input, button, select, textarea {
      font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, system-ui, sans-serif !important;
      letter-spacing: -0.025em;
      word-break: keep-all;
      overflow-wrap: break-word;
    }
    body {
      color: #111111;
      background-color: #ffffff;
      -webkit-tap-highlight-color: transparent;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      text-rendering: optimizeLegibility;
    }

    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    /* Active Menu Tab Indicator */
    .nav-tab-btn.is-active {
      color: #0c2f24 !important;
      font-weight: 800 !important;
      border-bottom: 2.5px solid #0c2f24;
    }

    /* Section Smooth Transition */
    .content-section {
      animation: fadeInSection 0.3s ease-out forwards;
    }
    @keyframes fadeInSection {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Wix Live Editor Styles */
    body.is-editing [data-editable] {
      outline: 1.5px dashed rgba(34, 197, 94, 0.6);
      outline-offset: 3px;
      cursor: text;
    }
    body.is-editing [data-editable]:hover {
      outline: 2px solid #16a34a;
      background-color: rgba(34, 197, 94, 0.08);
      border-radius: 4px;
    }
    body.is-editing [data-editable]:focus {
      outline: 2.5px solid #0c2f24;
      background-color: rgba(34, 197, 94, 0.15);
      border-radius: 4px;
    }

    /* Universal Editable Images in Edit Mode */
    body.is-editing img {
      cursor: pointer !important;
      transition: outline 0.15s ease, filter 0.15s ease;
      outline: 2px dashed rgba(245, 158, 11, 0.7);
    }
    body.is-editing img:hover {
      outline: 3px solid #f59e0b;
      filter: brightness(0.95);
    }
    body.is-editing img.is-active-img {
      outline: 3.5px solid #10b981 !important;
      outline-offset: 3px;
      box-shadow: 0 0 25px rgba(16, 185, 129, 0.5) !important;
    }
    
    .add-image-box {
      display: none;
    }
    body.is-editing .add-image-box {
      display: flex;
    }

    /* 아이폰/스마트폰 목업 */
    .mockup-phone {
      width: 390px;
      height: 800px;
      background: #000;
      border-radius: 50px;
      border: 10px solid #1f2937;
      box-shadow: 0 25px 70px -15px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.1);
      position: relative;
      overflow: hidden;
    }
    .mockup-notch {
      position: absolute;
      top: 10px;
      left: 50%;
      transform: translateX(-50%);
      width: 100px;
      height: 22px;
      background: #000;
      border-radius: 14px;
      z-index: 50;
    }
  </style>
</head>
<body class="relative overflow-x-hidden antialiased selection:bg-sigan-green selection:text-white">

  <!-- ==================== WIX-STYLE FLOATING EDITOR TOOLBAR ==================== -->
  <aside id="editorToolbar" class="fixed top-4 right-4 z-[9999] bg-slate-900/95 backdrop-blur-md text-white px-3.5 py-2.5 rounded-2xl shadow-2xl border border-slate-700 flex flex-wrap items-center gap-2.5 transition-all duration-300">
    <div class="flex items-center space-x-2">
      <div id="editStatusDot" class="w-2.5 h-2.5 rounded-full bg-slate-500"></div>
      <span id="editStatusText" class="text-xs font-bold text-slate-300">보기 모드</span>
    </div>

    <div class="h-4 w-px bg-slate-700"></div>

    <!-- 리얼 모바일 폰 시뮬레이터 -->
    <button 
      onclick="openMobilePreviewModal()" 
      class="px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition flex items-center shadow">
      <i data-lucide="smartphone" class="w-3.5 h-3.5 mr-1.5"></i>
      <span>📱 리얼 모바일 화면 보기</span>
    </button>

    <!-- Toggle Edit Mode Button -->
    <button 
      id="toggleEditBtn" 
      onclick="toggleWixEditMode()" 
      class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center shadow">
      <i data-lucide="edit-3" class="w-3.5 h-3.5 mr-1"></i>
      <span id="toggleBtnText">Wix 편집 켜기</span>
    </button>

    <!-- Wix Editing Active Action Tools -->
    <div id="editorActionBtns" class="hidden flex items-center space-x-2">
      <!-- 새 이미지 추가 툴 -->
      <button 
        onclick="openAddImageModal()" 
        title="새 사진/이미지 원하는 위치에 추가" 
        class="px-3 py-1.5 rounded-lg bg-teal-600 hover:bg-teal-500 text-white text-xs font-bold transition flex items-center shadow">
        <i data-lucide="image-plus" class="w-3.5 h-3.5 mr-1"></i>
        <span>➕ 새 이미지 추가</span>
      </button>

      <!-- Save & Download -->
      <button 
        onclick="downloadEditedHtml()" 
        title="수정한 완성본 index.html 저장" 
        class="px-3 py-1.5 rounded-lg bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold transition flex items-center shadow">
        <i data-lucide="download" class="w-3.5 h-3.5 mr-1"></i>
        <span>수정본 파일 저장</span>
      </button>

      <button 
        onclick="resetToOriginal()" 
        title="초기 상태로 되돌리기" 
        class="p-1.5 rounded-lg bg-slate-800 hover:bg-rose-900/60 text-slate-400 hover:text-rose-300 text-xs transition">
        <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i>
      </button>
    </div>
  </aside>

  <!-- Hidden File Input for Single Image Replacement -->
  <input type="file" id="imageReplaceUploader" accept="image/*" class="hidden" onchange="handleReplaceImageSelected(event)">
  <!-- Hidden File Input for Adding New Image -->
  <input type="file" id="imageAddUploader" accept="image/*" class="hidden" onchange="handleAddImageFileSelected(event)">


  <!-- ==================== WIX IMAGE STUDIO PANEL ==================== -->
  <div id="imageStudioPanel" class="fixed bottom-6 right-4 sm:right-8 z-[10001] hidden w-[94vw] max-w-[440px] bg-slate-900/95 backdrop-blur-xl text-white rounded-3xl shadow-2xl border border-slate-700/80 p-5 space-y-4 max-h-[85vh] overflow-y-auto no-scrollbar">
    <div class="flex items-center justify-between pb-3 border-b border-slate-800">
      <div class="flex items-center space-x-2">
        <div class="p-1.5 rounded-lg bg-emerald-500/20 text-emerald-400">
          <i data-lucide="palette" class="w-4 h-4"></i>
        </div>
        <div>
          <h4 class="font-bold text-sm text-white">이미지 크기 & 스타일 조절 (Wix Studio)</h4>
          <p class="text-[11px] text-slate-400">클릭하신 이미지의 크기, 비율, 모양을 실시간 조절합니다.</p>
        </div>
      </div>
      <button onclick="closeImageStudio()" class="p-1 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800">
        <i data-lucide="x" class="w-4 h-4"></i>
      </button>
    </div>

    <!-- 사진 파일 교체 & 삭제 액션 -->
    <div class="flex items-center gap-2">
      <button onclick="triggerReplaceImage()" class="flex-1 py-2 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition flex items-center justify-center shadow">
        <i data-lucide="upload" class="w-3.5 h-3.5 mr-1.5"></i>
        내 PC에서 사진 교체
      </button>
      <button onclick="deleteActiveImage()" class="py-2 px-3 rounded-xl bg-rose-900/60 hover:bg-rose-800 text-rose-200 text-xs font-bold transition flex items-center justify-center">
        <i data-lucide="trash-2" class="w-3.5 h-3.5 mr-1"></i>
        삭제
      </button>
    </div>

    <!-- 가로 너비 (크기 조절) -->
    <div class="space-y-1.5 bg-slate-800/60 p-3.5 rounded-2xl border border-slate-700/50">
      <div class="flex justify-between items-center text-xs">
        <span class="font-bold text-slate-200">가로 너비 (크기)</span>
        <span id="labelWidthVal" class="font-bold text-emerald-400">100%</span>
      </div>
      <input type="range" id="sliderWidth" min="15" max="100" value="100" class="w-full accent-emerald-500 cursor-pointer" oninput="applyImageWidth(this.value)">
      <div class="grid grid-cols-5 gap-1.5 pt-1">
        <button onclick="applyImageWidthPreset('25%')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">25% (소)</button>
        <button onclick="applyImageWidthPreset('50%')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">50% (중)</button>
        <button onclick="applyImageWidthPreset('75%')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">75% (대)</button>
        <button onclick="applyImageWidthPreset('100%')" class="py-1 bg-emerald-600/80 hover:bg-emerald-600 text-[11px] rounded font-semibold text-white">100% (꽉참)</button>
        <button onclick="applyImageWidthPreset('auto')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">원본</button>
      </div>
    </div>

    <!-- 세로 높이 & 비율 조절 -->
    <div class="space-y-1.5 bg-slate-800/60 p-3.5 rounded-2xl border border-slate-700/50">
      <div class="flex justify-between items-center text-xs">
        <span class="font-bold text-slate-200">높이 & 종횡비</span>
        <span id="labelHeightVal" class="font-bold text-emerald-400">자동 비율</span>
      </div>
      <div class="grid grid-cols-4 gap-1.5 pb-2">
        <button onclick="applyImageRatio('auto')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">원본비율</button>
        <button onclick="applyImageRatio('16/9')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">16:9 와이드</button>
        <button onclick="applyImageRatio('4/3')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">4:3 표준</button>
        <button onclick="applyImageRatio('1/1')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">1:1 정사각</button>
      </div>
      <input type="range" id="sliderHeight" min="120" max="600" value="300" class="w-full accent-emerald-500 cursor-pointer" oninput="applyImageHeight(this.value)">
    </div>

    <!-- 모양 -->
    <div class="space-y-1.5 bg-slate-800/60 p-3.5 rounded-2xl border border-slate-700/50">
      <span class="font-bold text-xs text-slate-200 block">모양 (모서리 곡률)</span>
      <div class="grid grid-cols-4 gap-1.5">
        <button onclick="applyImageShape('none')" class="py-1.5 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">각진 직각</button>
        <button onclick="applyImageShape('rounded-xl')" class="py-1.5 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">라운드(12px)</button>
        <button onclick="applyImageShape('rounded-3xl')" class="py-1.5 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">둥글게(24px)</button>
        <button onclick="applyImageShape('rounded-full')" class="py-1.5 bg-slate-700 hover:bg-slate-600 text-[11px] rounded font-semibold text-slate-200">타원 / 원형</button>
      </div>
    </div>

    <!-- 테두리 & 정렬 -->
    <div class="space-y-2 bg-slate-800/60 p-3.5 rounded-2xl border border-slate-700/50">
      <span class="font-bold text-xs text-slate-200 block">테두리 & 정렬</span>
      <div class="grid grid-cols-4 gap-1.5">
        <button onclick="applyImageBorder('none')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded text-slate-200">테두리 없음</button>
        <button onclick="applyImageBorder('slate')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded text-slate-200">실선 테두리</button>
        <button onclick="applyImageBorder('gold')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded text-amber-300">골드 테두리</button>
        <button onclick="applyImageBorder('green')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded text-emerald-300">그린 테두리</button>
      </div>
      <div class="grid grid-cols-3 gap-1.5 pt-1">
        <button onclick="applyImageAlign('left')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded text-slate-200">좌측 정렬</button>
        <button onclick="applyImageAlign('center')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded text-slate-200">가운데 정렬</button>
        <button onclick="applyImageAlign('right')" class="py-1 bg-slate-700 hover:bg-slate-600 text-[11px] rounded text-slate-200">우측 정렬</button>
      </div>
    </div>

    <button onclick="closeImageStudio()" class="w-full py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs flex items-center justify-center transition shadow-lg">
      <i data-lucide="check" class="w-4 h-4 mr-1"></i>
      적용 완료 (닫기)
    </button>
  </div>


  <!-- ==================== ADD NEW IMAGE MODAL ==================== -->
  <div id="addImageModal" class="fixed inset-0 z-[10002] hidden bg-black/75 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-3xl max-w-md w-full p-6 text-white shadow-2xl space-y-4">
      <div class="flex justify-between items-center pb-3 border-b border-slate-800">
        <div class="flex items-center space-x-2">
          <i data-lucide="image-plus" class="w-5 h-5 text-emerald-400"></i>
          <h3 class="font-bold text-base">새 이미지 추가하기</h3>
        </div>
        <button onclick="closeAddImageModal()" class="text-slate-400 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="space-y-3 text-xs">
        <div>
          <label class="block font-bold text-slate-300 mb-1">1. 이미지를 넣을 위치 (섹션)</label>
          <select id="newImageTargetSection" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white outline-none">
            <option value="gallery-overview">상업시설 공식 개요 / 조감도 갤러리</option>
            <option value="gallery-blocks">3블록·4블록 층별 MD 및 도면 갤러리</option>
            <option value="gallery-premium">공식 8대 프리미엄 영역</option>
            <option value="gallery-location">견본주택 오시는 길 영역</option>
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-300 mb-1">2. 사진 업로드 방법</label>
          <div class="grid grid-cols-2 gap-2">
            <button onclick="document.getElementById('imageAddUploader').click()" class="py-2.5 px-3 bg-emerald-600 hover:bg-emerald-500 rounded-xl font-bold text-white flex items-center justify-center shadow">
              <i data-lucide="hard-drive" class="w-3.5 h-3.5 mr-1.5"></i>
              내 PC 파일 선택
            </button>
            <button onclick="promptForImageUrl()" class="py-2.5 px-3 bg-slate-800 hover:bg-slate-700 rounded-xl font-bold text-slate-200 border border-slate-700 flex items-center justify-center">
              <i data-lucide="link" class="w-3.5 h-3.5 mr-1.5"></i>
              이미지 URL 입력
            </button>
          </div>
          <p id="newImageFileName" class="text-[11px] text-emerald-400 mt-1 font-semibold truncate"></p>
        </div>

        <div>
          <label class="block font-bold text-slate-300 mb-1">3. 사진 설명 문구 (캡션)</label>
          <input type="text" id="newImageCaption" placeholder="예: 인천계양 시간 조감도 전경" class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2 text-white outline-none" />
        </div>

        <div>
          <label class="block font-bold text-slate-300 mb-1">4. 초기 크기</label>
          <div class="grid grid-cols-3 gap-2">
            <label class="flex items-center space-x-1.5 p-2 bg-slate-800 rounded-xl border border-slate-700 cursor-pointer">
              <input type="radio" name="initSize" value="100%" checked class="accent-emerald-500">
              <span class="text-xs">100% 꽉참</span>
            </label>
            <label class="flex items-center space-x-1.5 p-2 bg-slate-800 rounded-xl border border-slate-700 cursor-pointer">
              <input type="radio" name="initSize" value="75%" class="accent-emerald-500">
              <span class="text-xs">75% 대형</span>
            </label>
            <label class="flex items-center space-x-1.5 p-2 bg-slate-800 rounded-xl border border-slate-700 cursor-pointer">
              <input type="radio" name="initSize" value="50%" class="accent-emerald-500">
              <span class="text-xs">50% 중형</span>
            </label>
          </div>
        </div>
      </div>

      <div class="pt-2 flex gap-2">
        <button onclick="confirmAddNewImage()" class="flex-1 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs transition shadow-lg flex items-center justify-center">
          <i data-lucide="plus-circle" class="w-4 h-4 mr-1.5"></i>
          지금 페이지에 삽입하기
        </button>
        <button onclick="closeAddImageModal()" class="py-3 px-4 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold rounded-xl text-xs">
          취소
        </button>
      </div>
    </div>
  </div>


  <!-- ==================== REAL MOBILE PREVIEW MODAL ==================== -->
  <div id="mobilePreviewModal" class="fixed inset-0 z-[10000] hidden bg-black/80 backdrop-blur-md flex items-center justify-center p-4">
    <div class="relative flex flex-col items-center">
      <div class="w-full max-w-[390px] flex justify-between items-center mb-3 text-white text-xs">
        <span class="flex items-center text-slate-300 font-medium">
          <i data-lucide="smartphone" class="w-4 h-4 mr-1 text-emerald-400"></i>
          실제 스마트폰 화면 시뮬레이터 (390px)
        </span>
        <button onclick="closeMobilePreviewModal()" class="px-2.5 py-1 bg-white/20 hover:bg-white/30 rounded-lg text-white font-bold flex items-center">
          <i data-lucide="x" class="w-4 h-4 mr-1"></i> 닫기
        </button>
      </div>

      <div class="mockup-phone">
        <div class="mockup-notch"></div>
        <iframe id="mobilePreviewFrame" src="" class="w-full h-full border-0 bg-white pt-6"></iframe>
      </div>
      
      <p class="text-[11px] text-slate-400 mt-3 text-center">
        ※ 실제 핸드폰 기기에서 접속했을 때 나타나는 100% 동일한 반응형 화면입니다.
      </p>
    </div>
  </div>


  <!-- ==================== MAP ZOOM MODAL (광역도 고화질 확대 뷰어) ==================== -->
  <div id="mapZoomModal" class="fixed inset-0 z-[10003] hidden bg-black/90 backdrop-blur-md flex items-center justify-center p-2 sm:p-6" onclick="closeMapZoomModal()">
    <div class="relative max-w-6xl w-full max-h-[92vh] flex flex-col items-center" onclick="event.stopPropagation()">
      <div class="w-full flex justify-between items-center text-white mb-2 px-2">
        <span class="text-sm font-bold text-slate-200 flex items-center">
          <i data-lucide="map" class="w-4 h-4 mr-1.5 text-sigan-gold"></i>
          공식 광역도 원본 고화질 뷰어
        </span>
        <button onclick="closeMapZoomModal()" class="px-3 py-1.5 bg-white/20 hover:bg-white/30 rounded-xl text-white font-bold text-xs flex items-center">
          <i data-lucide="x" class="w-4 h-4 mr-1"></i> 닫기
        </button>
      </div>
      <div class="w-full overflow-auto max-h-[85vh] rounded-2xl border border-white/20 bg-slate-950 p-2 text-center">
        <img id="zoomModalImg" src="" alt="고화질 광역도" class="max-w-none w-full sm:w-auto sm:max-w-full h-auto object-contain mx-auto" />
      </div>
    </div>
  </div>


  <!-- ==================== TOP OFFICIAL BAR ==================== -->
  <div class="bg-sigan-greenDeep text-slate-300 text-xs py-2 px-4 border-b border-white/10 hidden md:block">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center space-x-3">
        <span class="inline-flex items-center text-sigan-gold font-bold">
          <i data-lucide="check-check" class="w-4 h-4 mr-1 text-sigan-gold"></i>
          계양신도시 첫 라이프 스테이 몰 「시간 (時間)」 공식 안내
        </span>
        <span class="text-slate-500">|</span>
        <span class="text-slate-300" data-editable>시공: 반도건설(주)</span>
      </div>
      <div class="flex items-center space-x-5 text-slate-300">
        <span class="flex items-center" data-editable>
          <i data-lucide="map-pin" class="w-3.5 h-3.5 mr-1 text-sigan-gold"></i>
          견본주택: 경기 부천시 원미구 도당동 222-46 (서울 양천구 신월동 537-1 외)
        </span>
        <span class="text-slate-500">|</span>
        <a href="tel:1800-0320" class="text-sigan-gold hover:text-white font-bold flex items-center">
          <i data-lucide="phone-call" class="w-3.5 h-3.5 mr-1"></i>
          대표문의: 1800-0320
        </a>
      </div>
    </div>
  </div>


  <!-- ==================== HEADER & SPA NAVIGATION ==================== -->
  <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16 sm:h-20">
        
        <!-- 공식 이미지 로고 -->
        <a href="javascript:showSection('all')" class="flex items-center space-x-3 group py-1">
          <img 
            src="images/logo.png" 
            alt="인천계양 상업시설 시간 공식 로고" 
            class="h-12 sm:h-14 w-auto object-contain transition-transform group-hover:scale-105"
            data-editable-img
          />
          <div class="flex flex-col">
            <div class="flex items-center space-x-1.5">
              <span class="text-xs sm:text-sm text-sigan-green font-extrabold tracking-wider" data-editable>인천계양 AC3·AC4BL</span>
              <span class="text-[10px] sm:text-xs bg-sigan-green text-white px-1.5 py-0.5 rounded font-semibold">공식</span>
            </div>
            <span class="text-xs text-slate-500 font-semibold" data-editable>반도건설 라이프 스테이 몰</span>
          </div>
        </a>

        <!-- Desktop Menu Bar -->
        <nav class="hidden lg:flex items-center space-x-1">
          <button onclick="showSection('all')" id="navBtn-all" class="nav-tab-btn is-active px-3 py-2 text-sm font-bold text-slate-700 hover:text-sigan-green transition border-b-2 border-transparent">
            전체보기
          </button>
          <button onclick="showSection('overview')" id="navBtn-overview" class="nav-tab-btn px-3 py-2 text-sm font-bold text-slate-700 hover:text-sigan-green transition border-b-2 border-transparent">
            사업개요
          </button>
          <button onclick="showSection('premium')" id="navBtn-premium" class="nav-tab-btn px-3 py-2 text-sm font-bold text-slate-700 hover:text-sigan-green transition border-b-2 border-transparent">
            8대 프리미엄
          </button>
          <button onclick="showSection('rarity')" id="navBtn-rarity" class="nav-tab-btn px-3 py-2 text-sm font-bold text-slate-700 hover:text-sigan-green transition border-b-2 border-transparent">
            0.91% 희소가치
          </button>
          <button onclick="showSection('blocks')" id="navBtn-blocks" class="nav-tab-btn px-3 py-2 text-sm font-bold text-slate-700 hover:text-sigan-green transition border-b-2 border-transparent">
            3·4블록 MD
          </button>
          <button onclick="showSection('location')" id="navBtn-location" class="nav-tab-btn px-3 py-2 text-sm font-bold text-slate-700 hover:text-sigan-green transition border-b-2 border-transparent">
            오시는 길
          </button>
          <button onclick="showSection('inquiry')" id="navBtn-inquiry" class="ml-2 px-4 py-2 rounded-xl bg-sigan-green text-white text-sm font-bold hover:bg-sigan-greenLight transition shadow-md flex items-center">
            <i data-lucide="calendar" class="w-3.5 h-3.5 mr-1.5 text-sigan-gold"></i>
            VIP 상담신청
          </button>
        </nav>

        <!-- Mobile Header Actions -->
        <div class="flex items-center space-x-2 lg:hidden">
          <a href="tel:1800-0320" class="p-2 rounded-lg bg-emerald-50 text-sigan-green border border-emerald-200">
            <i data-lucide="phone" class="w-5 h-5"></i>
          </a>
          <button id="mobileMenuBtn" class="p-2 rounded-lg bg-slate-100 text-slate-800">
            <i data-lucide="menu" class="w-6 h-6"></i>
          </button>
        </div>

      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobileMenu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 py-3 space-y-1">
      <button onclick="showSection('all'); toggleMobileMenu()" class="block w-full text-left px-3 py-2.5 rounded-lg text-sm font-bold text-sigan-green bg-emerald-50">
        전체 한눈에 보기
      </button>
      <button onclick="showSection('overview'); toggleMobileMenu()" class="block w-full text-left px-3 py-2.5 rounded-lg text-sm font-bold text-slate-800 hover:bg-slate-50">
        1. 사업개요 (AC3BL · AC4BL 면적표)
      </button>
      <button onclick="showSection('premium'); toggleMobileMenu()" class="block w-full text-left px-3 py-2.5 rounded-lg text-sm font-bold text-slate-800 hover:bg-slate-50">
        2. 공식 8대 프리미엄 (PREMIUM 8)
      </button>
      <button onclick="showSection('rarity'); toggleMobileMenu()" class="block w-full text-left px-3 py-2.5 rounded-lg text-sm font-bold text-slate-800 hover:bg-slate-50">
        3. 상업용지비율 0.91% 희소가치 비교
      </button>
      <button onclick="showSection('blocks'); toggleMobileMenu()" class="block w-full text-left px-3 py-2.5 rounded-lg text-sm font-bold text-slate-800 hover:bg-slate-50">
        4. 3블록·4블록 층별 MD 구성
      </button>
      <button onclick="showSection('location'); toggleMobileMenu()" class="block w-full text-left px-3 py-2.5 rounded-lg text-sm font-bold text-slate-800 hover:bg-slate-50">
        5. 입지환경 및 견본주택 오시는길
      </button>
      <button onclick="showSection('inquiry'); toggleMobileMenu()" class="block w-full text-center px-3 py-3 rounded-lg text-sm font-bold text-white bg-sigan-green mt-2">
        VIP 방문예약 및 상담신청
      </button>
    </div>
  </header>


  <!-- Section View Indicator Bar -->
  <div id="sectionIndicatorBar" class="hidden bg-emerald-900 text-white py-2.5 px-4 text-xs font-bold text-center border-b border-emerald-800">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <span class="flex items-center">
        <i data-lucide="eye" class="w-4 h-4 mr-1.5 text-sigan-gold"></i>
